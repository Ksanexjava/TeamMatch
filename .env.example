MAX_BOT_TOKEN=
DATABASE_URL=
REDIS_URL=
LOG_LEVEL=INFO
SEED_TEST_PROFILES=1

# --- Что запускать вместе с ботом MAX ---
# telegram        — Telegram-бот (чат с кнопками; домен не нужен)
# telegram,webapp — плюс мини-приложение и HTTPS-прокси (нужен домен)
COMPOSE_PROFILES=

# --- Telegram ---
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Свой ретранслятор Bot API — нужен, только если хостинг не выпускает
# соединения к api.telegram.org (симптом: бот падает с таймаутом).
# Как поднять — tools/telegram-relay-worker.js и раздел в DEPLOY.md.
# Пример: https://teammate-tg.ваш-поддомен.workers.dev/<секрет>
TELEGRAM_API_BASE=
# 0 — не показывать в Telegram кнопку мини-приложения, только чат с кнопками
TELEGRAM_WEBAPP_BUTTON=1

# --- Мини-приложение (Telegram и MAX) ---
# Домен мини-приложения, A-запись должна смотреть на этот сервер (например app.teammate.ru)
WEBAPP_DOMAIN=
# Полный адрес мини-приложения: https://<WEBAPP_DOMAIN>
WEBAPP_URL=

# Отдельный адрес мини-приложения для Telegram. Нужен, только если прямой
# домен открывается не у всех (например, не проходит из-под VPN) и перед ним
# поставлен ретранслятор — tools/webapp-proxy-worker.js. Пусто — берётся WEBAPP_URL.
TELEGRAM_WEBAPP_URL=
# Сколько секунд действует подпись запуска (initData)
INIT_DATA_TTL=86400
# 1 — вход без мессенджера, ТОЛЬКО для локальной разработки
WEBAPP_DEV_AUTH=0

# --- Одна анкета в Telegram и MAX ---
# Имена ботов без @ — для кнопок «Открыть в Telegram / MAX» с кодом привязки
TELEGRAM_BOT_USERNAME=
MAX_BOT_USERNAME=

# --- Персональные данные (152-ФЗ) ---
# Где опубликованы /legal/consent и /legal/privacy (по умолчанию — WEBAPP_URL)
LEGAL_BASE_URL=
# Редакция согласия: поменяй дату, когда меняешь текст webapp/static/legal/consent.html
CONSENT_VERSION=2026-11-17
# Почта для обращений по персональным данным и жалоб
SUPPORT_EMAIL=m.mikhailov2@g.nsu.ru

# Редактор мероприятий на /admin. Пусто — редактор выключен.
# Задайте длинную случайную строку, например: openssl rand -hex 24
ADMIN_TOKEN=
