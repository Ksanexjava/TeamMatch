# Скопируй этот файл в .env и впиши свой токен. Файл .env в Git не попадает.

# Токен бота MAX (у каждого разработчика — свой тестовый бот)
MAX_BOT_TOKEN=

# База данных. Пусто → локальный файл SQLite (local.db), удобно запускать без Docker.
# В docker compose адрес Postgres подставляется автоматически.
DATABASE_URL=

# Redis для хранения шагов анкеты. Пусто → хранение в памяти.
REDIS_URL=

LOG_LEVEL=INFO

# 1 — загрузить 40 тестовых анкет из data/test_profiles.json при первом запуске
SEED_TEST_PROFILES=1
